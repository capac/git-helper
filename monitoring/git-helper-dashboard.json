          "rawQuery": true,
          "rawSql": "SELECT\n    DATE_TRUNC('day', q.ts) AS time,\n    ROUND(AVG(\n        CASE WHEN f.rating = 1 THEN 1.0 / rd.rank ELSE 0.0 END\n    )::NUMERIC, 3) AS mrr\nFROM queries q\nLEFT JOIN feedback f ON f.query_id = q.id\nLEFT JOIN retrieved_docs rd ON rd.query_id = q.id AND rd.rank = 1\nWHERE q.ts BETWEEN $__timeFrom() AND $__timeTo()\nGROUP BY 1\nORDER BY 1;",
